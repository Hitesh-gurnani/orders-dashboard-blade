{
    "name": "northwind/orders-dashboard",
    "description": "An orders dashboard built with Blade components and hand-written CSS, running without the Laravel framework.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/container": "^12.0",
        "illuminate/events": "^12.0",
        "illuminate/filesystem": "^12.0",
        "illuminate/view": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public",
        "test": "php tests/run.php"
    },
    "config": {
        "sort-packages": true
    }
}
